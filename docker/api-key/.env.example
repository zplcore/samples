# Copy to .env and replace the values. Never commit .env.
# API keys: at least 16 characters, e.g. generated with: openssl rand -hex 24
ZPLCORE_API_KEY=replace-with-a-long-random-key
ZPLCORE_DESIGNER_API_KEY=replace-with-another-long-random-key

# Optional licence key (https://zplcore.com/pricing/); empty = evaluation mode with watermark
ZPLCORE_LICENSE_KEY=
